# Environment Variables
# Copy this to .env.local and fill in your values

# Google Sheets Integration (optional - falls back to demo data)
# 1. Create a Google Sheet with a "Projects" tab and a "Config" tab
# 2. Publish it: File → Share → Publish to Web → Entire Document
# 3. Copy the spreadsheet ID from the URL
NEXT_PUBLIC_GOOGLE_SHEET_ID=
NEXT_PUBLIC_PROJECTS_TAB=Projects
NEXT_PUBLIC_CONFIG_TAB=Config

# Projects tab columns:
# id | title | category | year | description | thumbnail | images | featured
#
# - id: unique slug (e.g. "my-project")
# - title: project name
# - category: Art, Architecture, Product Design, etc.
# - year: 2024
# - description: project description
# - thumbnail: image URL (Google Drive share link or any public URL)
# - images: comma-separated image URLs for detail page
# - featured: true/false (shown in hero carousel)
#
# Config tab columns:
# key | value
#
# Supported keys: name, tagline, email, instagram, linkedin
