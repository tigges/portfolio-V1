DirectoryIndex index.html

RewriteEngine On

# Serve existing files directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Serve directory with index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ %{REQUEST_URI}/index.html [L]

# Append .html for clean URLs
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ /$1.html [L]

# For project detail pages with IDs not pre-built, serve any existing project page
# The client-side DataProvider + useParams will load the correct project
RewriteCond %{REQUEST_URI} ^/project/
RewriteRule ^project/.*$ /project/concrete-horizon.html [L]

# Fallback to index.html for other client-side routes
RewriteRule ^ /index.html [L]
